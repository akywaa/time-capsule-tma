{
  "builds": [
    {
      "src": "api/index.go",
      "use": "@vercel/go"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "safe.glb",
      "use": "@vercel/static"
    },
    {
      "src": "sci-fi_box.glb",
      "use": "@vercel/static"
    },
    {
      "src": "love_box.glb",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.go"
    },
    {
      "src": "/safe.glb",
      "dest": "/safe.glb"
    },
    {
      "src": "/safe-open.glb",
      "dest": "/safe-open.glb"
    },
    {
      "src": "/love_box.glb",
      "dest": "/love_box.glb"
    },
    {
      "src": "/sci-fi_box.glb",
      "dest": "/sci-fi_box.glb"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}